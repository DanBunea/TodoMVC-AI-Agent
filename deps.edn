{:paths ["resources"
         "components/logging/src"
         "components/state.machines/resources"
         "components/state.machines/src"
         "components/datastar/resources"
         "components/datastar/src"
         "components/datastar/test"

         "components/llm/resources"
         "components/llm/src"
         "components/agents/src"
         "bases/server/resources"
         "bases/server/src"
         "bases/web/resources"
         "bases/web/src"]
 :deps {;; electric

        ;; server
        ring/ring                      {:mvn/version "1.15.3"} ; comes with Jetty
        metosin/reitit                 {:mvn/version "0.7.2"}

        ;; tests
        com.hyperfiddle/rcf            {#_:mvn/version #_"20220926-202227"
                                        :git/url "https://github.com/DanBunea/rcf"
                                        :git/sha "641f5382501991163f4f4647618f0e3eb62d193e"}
        tortue/spy                     {:mvn/version "2.13.0"}

;; cljc
        org.clojure/clojure {:mvn/version "1.12.4"}
        org.clojure/clojurescript {:mvn/version "1.11.60"}

        ;;core.async.flow
        org.clojure/core.async {:mvn/version "1.9.808-alpha1"}
        io.github.clojure/core.async.flow-monitor {:git/tag "v0.1.1" :git/sha "61e8d31"}

;; logging
        org.clojure/tools.logging {:mvn/version "1.2.4"}
        ch.qos.logback/logback-classic {:mvn/version "1.4.14"}

        com.brunobonacci/mulog                 {:mvn/version "0.10.1"}

;;specs
        metosin/malli {:mvn/version "0.12.0"}

        ;;http
        cheshire/cheshire {:mvn/version "5.12.0"}
        hato/hato {:mvn/version "1.0.0"}

        ;; configuration
        aero/aero {:mvn/version "1.1.6"}

        ;;llm eca
        camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
        babashka/fs {:mvn/version "0.5.26"}

         ;; for datastar
        dev.data-star.clojure/sdk {:mvn/version "1.0.0-RC1"}
        dev.data-star.clojure/ring {:mvn/version "1.0.0-RC1"}
        dev.onionpancakes/chassis  {:mvn/version "1.0.365"}
        com.cnuernber/charred      {:mvn/version "1.034"}}

 :aliases {:dev
           {:extra-paths ["development/src-dev"]
            :extra-deps  {com.brunobonacci/mulog-zipkin  {:mvn/version "0.10.1"}
                          thheller/shadow-cljs          {:mvn/version "2.26.2"}
                          io.github.clojure/tools.build {:mvn/version "0.9.6"
                                                         :exclusions  [com.google.guava/guava  ; Guava version conflict between tools.build and clojurescript.
                                                                       org.slf4j/slf4j-nop]}

                          org.clojars.abhinav/snitch    {:mvn/version "0.1.15"}}} ; clashes with app logger
           :test
           {:jvm-opts ["-Dhyperfiddle.rcf.generate-tests=true"]

            :extra-paths ["development/test"
                          "components/state.machines/test"
                          "bases/server/test"]
            :extra-deps  {lambdaisland/kaocha {:mvn/version "1.60.945"}
                          com.datomic/local    {:mvn/version "1.0.267"}}
            :main-opts   ["-m" "kaocha.runner"]}

           :prod
           {:extra-paths ["development/src-prod"]}

           :build ; use `clj -X:build build-client`, NOT -T! build/app classpath contamination cannot be prevented
           {:extra-paths ["development/src-build"]
            :ns-default  build
            :extra-deps  {thheller/shadow-cljs          {:mvn/version "2.26.2"}
                          io.github.clojure/tools.build {:mvn/version "0.9.6"
                                                         :exclusions  [com.google.guava/guava   ; Guava version conflict between tools.build and clojurescript.
                                                                       org.slf4j/slf4j-nop]}}} ; clashes with app logger
           :nextjournal/garden
           {:extra-paths ["development/src-prod"]
            :exec-fn     prod/-main}

;; Clojure MCP
           :nrepl
           {:extra-paths ["test"]
            :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
            :jvm-opts ["-Djdk.attach.allowAttachSelf"]
            :main-opts ["-m" "nrepl.cmdline" "--port" "7888"]}}}


